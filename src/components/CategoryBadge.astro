---
import { categoryLabel, categoryGroup } from '../lib/articles';
import type { CategorySlug } from '../lib/articles';

interface Props {
  category: CategorySlug;
}

const { category } = Astro.props;
const group = categoryGroup(category);
---

<a href={`/news/${category}`} class:list={['badge', `badge--${group}`, category === 'luxury' && 'badge--luxury']}>{categoryLabel(category)}</a>

<style>
  .badge {
    display: inline-block;
    text-decoration: none;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    padding: 0.25em 0.65em;
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-ink-muted);
  }

  .badge--macro {
    background: color-mix(in srgb, var(--color-accent) 14%, var(--color-surface));
    color: var(--color-accent);
  }

  .badge--luxury {
    background: color-mix(in srgb, var(--color-complementary) 16%, var(--color-surface));
    color: var(--color-complementary);
  }
</style>
