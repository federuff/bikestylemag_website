---
import CategoryBadge from './CategoryBadge.astro';
import type { Article } from '../lib/articles';

interface Props {
  article: Article;
}

const { article } = Astro.props;
const { title, description, pubDate, categories, heroImage } = article.data;
const href = `/articles/${article.id}`;

const formattedDate = pubDate.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<div class="card">
  <a class="thumb-link" href={href} tabindex="-1" aria-hidden="true">
    <div class="thumb" style={heroImage ? `background-image: url(${heroImage})` : undefined}>
      {!heroImage && <span class="thumb-fallback" aria-hidden="true" />}
    </div>
  </a>
  <div class="body">
    <div class="badges">
      {categories.map((category) => <CategoryBadge category={category} />)}
    </div>
    <a class="title-link" href={href}>
      <h3>{title}</h3>
      <p>{description}</p>
    </a>
    <time datetime={pubDate.toISOString()}>{formattedDate}</time>
  </div>
</div>

<style>
  .card {
    display: flex;
    flex-direction: column;
  }

  .thumb-link,
  .title-link {
    text-decoration: none;
    color: inherit;
  }

  .thumb {
    aspect-ratio: 4 / 3;
    border-radius: 4px;
    background-color: var(--color-surface);
    background-size: cover;
    background-position: center;
    margin-bottom: var(--space-2);
    overflow: hidden;
  }

  .thumb-fallback {
    display: block;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--color-surface), var(--color-border));
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em;
    margin-bottom: var(--space-1);
  }

  .body h3 {
    font-size: 1.25rem;
    margin-block: var(--space-1) 0.4em;
  }

  .body p {
    color: var(--color-ink-muted);
    font-size: 0.9375rem;
    margin-bottom: var(--space-1);
  }

  time {
    font-size: 0.8125rem;
    color: var(--color-ink-muted);
  }

  .title-link:hover h3 {
    color: var(--color-accent);
  }
</style>
