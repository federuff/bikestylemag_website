---
import CategoryBadge from './CategoryBadge.astro';
import type { Article } from '../lib/articles';

interface Props {
  article: Article;
}

const { article } = Astro.props;
const { title, description, pubDate, category, heroImage } = article.data;

const formattedDate = pubDate.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<a class="card" href={`/articles/${article.id}`}>
  <div class="thumb" style={heroImage ? `background-image: url(${heroImage})` : undefined}>
    {!heroImage && <span class="thumb-fallback" aria-hidden="true" />}
  </div>
  <div class="body">
    <CategoryBadge category={category} />
    <h3>{title}</h3>
    <p>{description}</p>
    <time datetime={pubDate.toISOString()}>{formattedDate}</time>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }

  .thumb {
    aspect-ratio: 4 / 3;
    border-radius: 4px;
    background-color: var(--color-surface);
    background-size: cover;
    background-position: center;
    margin-bottom: var(--space-2);
    overflow: hidden;
  }

  .thumb-fallback {
    display: block;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--color-surface), var(--color-border));
  }

  .body h3 {
    font-size: 1.25rem;
    margin-block: var(--space-1) 0.4em;
  }

  .body p {
    color: var(--color-ink-muted);
    font-size: 0.9375rem;
    margin-bottom: var(--space-1);
  }

  time {
    font-size: 0.8125rem;
    color: var(--color-ink-muted);
  }

  .card:hover h3 {
    color: var(--color-accent);
  }
</style>
