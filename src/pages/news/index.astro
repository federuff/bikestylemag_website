---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getPublishedArticles } from '../../lib/articles';

const articles = await getPublishedArticles();
---

<BaseLayout
  title="News"
  description="All BikeStyle Mag news on design, bicycles, e-bikes and sustainable urban mobility."
>
  <section class="wrapper">
    <header class="page-header">
      <h1>News</h1>
      <p>Design, bicycles, e-bikes and urban mobility: every article, newest first.</p>
    </header>

    {articles.length > 0 ? (
      <div class="grid">
        {articles.map((article) => <ArticleCard article={article} />)}
      </div>
    ) : (
      <p class="empty">No articles published yet — check back soon.</p>
    )}
  </section>
</BaseLayout>

<style>
  .page-header {
    padding-block: var(--space-6) var(--space-4);
  }

  .page-header p {
    color: var(--color-ink-muted);
    margin: 0;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--space-4);
    padding-bottom: var(--space-8);
  }

  .empty {
    color: var(--color-ink-muted);
    padding-bottom: var(--space-8);
  }
</style>
